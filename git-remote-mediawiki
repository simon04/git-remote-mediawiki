# It's not always possible to delete pages (may require some
# privileges). Deleted pages are replaced with this content.
DELETED_CONTENT = '[[Category:Deleted]]\n'

# It's not possible to create empty pages. New empty files in Git are
# sent with this content instead.
EMPTY_CONTENT = '<!-- empty page -->\n'

# Content used in place of a revision whose text has been suppressed.
SUPPRESSED_REVISION = '<!-- suppressed revision -->\n'

# Used on Git's side to reflect empty edit messages on the wiki
EMPTY_MESSAGE = '*Empty MediaWiki Message*'

# Number of pages taken into account at once in submodule get_mw_page_list
SLICE_SIZE = 50

# Number of linked mediafile to get at once in get_linked_mediafiles
# The query is split in small batches because of the MW API limit of
# the number of links to be returned (500 links max).
BATCH_SIZE = 10

# Number of revisions whose content is fetched in a single API call.
# FIXME: Need to fetch max_revs per-repo in case they have a client
# that can fetch more on a wiki
MAX_REVS = 50


def is_null_sha1(sha1):
    """Tell whether ``sha1`` is the all-zero object name used by diff-tree."""
    return bool(sha1) and set(sha1) == {'0'}


############################ fast-import output ###############################


def emit(text):
    """Write ``text`` to the fast-import stream, encoded as UTF-8."""
    sys.stdout.buffer.write(text.encode('utf-8'))


def literal_data(content):
    """Emit a fast-import ``data`` command; binary content is passed as bytes."""
    if isinstance(content, str):
        content = content.encode('utf-8')
    sys.stdout.buffer.write(b'data %d\n' % len(content))
    sys.stdout.buffer.write(content)


def fe_escape_path(path):
    """Quote ``path`` the way the fast-import stream expects it."""
    path = path.replace('\\', '\\\\').replace('"', '\\"').replace('\n', '\\n')
    return f'"{path}"'


class CommandError(Exception):
    """Raised when a remote-helper command line does not parse."""


class NonFastForward(Exception):
    """Raised when the wiki rejected an edit because it has moved ahead of us."""


class CommandParser(argparse.ArgumentParser):
    """An ArgumentParser that reports errors instead of exiting the helper."""

    def error(self, message):
        raise CommandError(message)


class GitRemoteMediaWiki:
    """The ``mediawiki::`` remote helper."""

    def __init__(self, remotename, url):
        self.remotename = remotename
        self.url = url

        self.tracked_pages = git_config_all(f'remote.{remotename}.pages')
        # Just like tracked_pages, but for MediaWiki categories.
        self.tracked_categories = git_config_all(f'remote.{remotename}.categories')
        # Just like tracked_categories, but for MediaWiki namespaces.
        self.tracked_namespaces = [
            namespace.replace('_', ' ')
            for namespace in git_config_all(f'remote.{remotename}.namespaces')
        ]

        # Import media files on pull
        self.import_media = git_config_bool(f'remote.{remotename}.mediaimport')
        # Export media files on push, unless explicitly turned off
        self.export_media = git_config_bool(
            f'remote.{remotename}.mediaexport', default=True
        )

        # Import only last revisions (both for clone and fetch)
        self.shallow_import = git_config_bool(f'remote.{remotename}.shallow')

        # Fetch (clone and pull) by revisions instead of by pages. This
        # behavior is more efficient when we have a wiki with lots of pages and
        # we fetch the revisions quite often so that they concern only few
        # pages. Possible values:
        # - by_rev: perform one query per new revision on the remote wiki
        # - by_page: query each tracked page for new revision
        self.fetch_strategy = git_config(
            f'remote.{remotename}.fetchStrategy'
        ) or git_config('mediawiki.fetchStrategy')

        # Force by_page if we are given a set of pages.
        #
        # This is especially needed on initial clones from large wikis since,
        # if fetchStrategy is set to by_rev, an array containing all revisions
        # ids is created in mw_import_ref_by_revs. On large wikis (e.g.
        # Wikipedia) this results in an OOM error.
        # See https://github.com/Git-Mediawiki/Git-Mediawiki/issues/71
        if not self.fetch_strategy or self.tracked_pages:
            self.fetch_strategy = 'by_page'

        # Dumb push: don't update notes and mediawiki ref to reflect the last
        # push.
        #
        # Configurable with mediawiki.dumbPush, or per-remote with
        # remote.<remotename>.dumbPush.
        #
        # This means the user will have to re-import the just-pushed
        # revisions. On the other hand, this means that the Git revisions
        # corresponding to MediaWiki revisions are all imported from the wiki,
        # regardless of whether they were initially created in Git or from the
        # web interface, hence all users will get the same history (i.e. if the
        # push from Git to MediaWiki loses some information, everybody will get
        # the history with information lost). If the import is deterministic,
        # this means everybody gets the same sha1 for each MediaWiki revision.
        self.dumb_push = git_config_bool(
            f'remote.{remotename}.dumbPush'
        ) or git_config_bool('mediawiki.dumbPush')

        wiki_name = re.sub(r'[^/]*://', '', url, count=1)
        # If URL is like http://user:password@example.com/, we clearly don't
        # want the password in wiki_name. While we're there, also remove user
        # and '@' sign, to avoid author like MWUser@HTTPUser@host.com
        self.wiki_name = re.sub(r'^.*@', '', wiki_name)

        # Remember the timestamp corresponding to a revision id.
        self.basetimestamps = {}

        # In memory cache for MediaWiki namespace ids, seeded from the
        # configuration file, where they are stored as
        # "Name_of_namespace:Id_namespace", ex.: "File:6".
        self.namespace_id = {}
        for entry in run_git(
            ['config', '--get-all', f'remote.{remotename}.namespaceCache'], quiet=True
        ).splitlines():
            name, _, namespace_id = entry.partition(':')
            self.namespace_id[name] = (
                None if namespace_id == 'notANameSpace' else int(namespace_id)
            )
        # Namespaces already on disk, which must not be written out again.
        self.cached_mw_namespace_id = set(self.namespace_id)

        self.command_parsers = self.build_command_parsers()

    ################################ error handling ###########################

    def fatal_mw_error(self, action, error=None):
        """Report that the remote does not look like a wiki, and give up."""
        warn(f'fatal: could not {action}.')
        warn(f"fatal: '{self.url}' does not appear to be a mediawiki")
        if self.url.startswith('https'):
            warn(f"fatal: make sure '{self.url}/api.php' is a valid page")
            warn('fatal: and the SSL certificate is correct.')
        else:
            warn(f"fatal: make sure '{self.url}/api.php' is a valid page.")
        if error is not None:
            warn(f'fatal: (error {error})')
        raise SystemExit(1)

    @cached_property
    def wiki(self):
        """The remote wiki, connected and logged in on first use."""
        try:
            return connect(self.remotename, self.url)
        except WIKI_ERRORS as error:
            self.fatal_mw_error('connect to the wiki', error)

    def connect(self):
        """Connect now, so that the login message precedes progress output."""
        return self.wiki

    ################################ command parser ###########################

    def build_command_parsers(self):
        """Build one argument parser per remote-helper command.

        Each parser knows which method implements the command; the parsed
        arguments are handed to it as keywords.
        """
        parsers = {}

        def add(name, handler):
            parser = CommandParser(prog=name, add_help=False)
            parser.set_defaults(handler=handler)
            parsers[name] = parser
            return parser

        add('capabilities', self.mw_capabilities)
        add('list', self.mw_list).add_argument('for_push', nargs='?')
        add('import', self.mw_import).add_argument('ref')
        option = add('option', self.mw_option)
        option.add_argument('name')
        option.add_argument('value')
        add('push', self.mw_push).add_argument('refspec', nargs='?', default='')

        return parsers

    def parse_command(self, line):
        """Run one remote-helper command; return False to stop the helper."""
        words = line.split()
        if not words:
            return False
        command, *arguments = words

        parser = self.command_parsers.get(command)
        if parser is None:
            warn('Unknown command. Aborting...')
            return False

        try:
            args = vars(parser.parse_args(arguments))
        except CommandError as error:
            raise SystemExit(f'Invalid "{command}" command: {error}') from error

        handler = args.pop('handler')
        handler(**args)
        return True

    ################ Functions for listing pages on the remote wiki ###########

    def get_mw_tracked_pages(self):
        """Return the pages the user asked to track, keyed by title."""
        return self.get_mw_page_list(self.tracked_pages)

    def get_mw_page_list(self, page_list):
        """Return the named pages, queried in slices, keyed by title."""
        pages = {}
        for chunk in itertools.batched(page_list, SLICE_SIZE, strict=False):
            pages |= self.get_mw_first_pages(chunk)
        return pages

    def get_mw_tracked_categories(self):
        """Return the pages of the tracked categories, keyed by title."""
        pages = {}
        for category in self.tracked_categories:
            if ':' not in category:
                # Mediawiki requires the Category prefix, but let's not force
                # the user to specify it.
                category = f'Category:{category}'
            try:
                mw_pages = self.wiki.query_list(
                    'categorymembers', cmtitle=category, cmlimit='max'
                )
            except WIKI_ERRORS as error:
                raise SystemExit(error) from error
            pages |= {page['title']: page for page in mw_pages}
        return pages

    def get_mw_tracked_namespaces(self):
        """Return the pages of the tracked namespaces, keyed by title."""
        pages = {}
        for local_namespace in sorted(self.tracked_namespaces):
            if local_namespace == '(Main)':
                namespace_id = 0
            else:
                namespace_id = self.get_mw_namespace_id(local_namespace)
            # virtual namespaces don't support allpages
            if namespace_id is None or namespace_id < 0:
                continue
            try:
                mw_pages = self.wiki.query_list(
                    'allpages', apnamespace=namespace_id, aplimit='max'
                )
            except WIKI_ERRORS as error:
                raise SystemExit(error) from error
            warn(f'{len(mw_pages)} found in namespace {local_namespace} ({namespace_id})')
            pages |= {page['title']: page for page in mw_pages}
        return pages

    def get_mw_all_pages(self):
        """Return every page of the wiki, keyed by title."""
        # No user-provided list, get the list of pages from the API.
        try:
            mw_pages = self.wiki.query_list('allpages', aplimit='max')
        except WIKI_ERRORS as error:
            self.fatal_mw_error('get the list of wiki pages', error)
        return {page['title']: page for page in mw_pages}

    def get_mw_first_pages(self, some_pages):
        """Query the wiki for a slice of the page list, keyed by title."""
        # pattern 'page1|page2|...' required by the API
        titles = '|'.join(some_pages)
        try:
            mw_pages = self.wiki.query(titles=titles)
        except WIKI_ERRORS as error:
            self.fatal_mw_error('query the list of wiki pages', error)

        pages = {}
        for page_id, page in mw_pages.get('query', {}).get('pages', {}).items():
            if int(page_id) < 0:
                warn(f'Warning: page {page["title"]} not found on wiki')
            else:
                pages[page['title']] = page
        return pages

    def get_mw_pages(self):
        """Get the list of pages to be fetched according to configuration."""
        self.connect()

        warn('Listing pages on remote wiki...')

        user_defined = bool(
            self.tracked_pages or self.tracked_categories or self.tracked_namespaces
        )

        pages = {}  # keyed on page titles to avoid duplicates
        if self.tracked_pages:
            # The user provided a list of pages titles, but we still need to
            # query the API to get the page IDs.
            pages |= self.get_mw_tracked_pages()
        if self.tracked_categories:
            pages |= self.get_mw_tracked_categories()
        if self.tracked_namespaces:
            pages |= self.get_mw_tracked_namespaces()
        if not user_defined:
            pages |= self.get_mw_all_pages()

        if self.import_media:
            warn('Getting media files for selected pages...')
            pages |= (
                self.get_linked_mediafiles(pages)
                if user_defined
                else self.get_all_mediafiles()
            )

        warn(f'{len(pages)} pages found.')
        return pages

    def get_all_mediafiles(self):
        """Return every media file page of the wiki, keyed by title."""
        # Attach list of all pages for media files from the API, they are in a
        # different namespace, only one namespace can be queried at the same
        # moment
        try:
            mw_pages = self.wiki.query_list(
                'allpages',
                apnamespace=self.get_mw_namespace_id('File'),
                aplimit='max',
            )
        except WIKI_ERRORS as error:
            warn('fatal: could not get the list of pages for media files.')
            warn(f"fatal: '{self.url}' does not appear to be a mediawiki")
            warn(f"fatal: make sure '{self.url}/api.php' is a valid page.")
            warn(f'fatal: (error {error})')
            raise SystemExit(1) from error
        return {page['title']: page for page in mw_pages}

    def get_linked_mediafiles(self, pages):
        """Return the media files included or linked from ``pages``."""
        titles = [page['title'] for page in pages.values()]
        mediafiles = {}

        for batch in itertools.batched(titles, BATCH_SIZE, strict=False):
            # pattern 'page1|page2|...' required by the API
            mw_titles = '|'.join(batch)

            # Media files could be included or linked from a page, get all
            # related
            result = self.wiki.query(
                prop='links|images',
                titles=mw_titles,
                plnamespace=self.get_mw_namespace_id('File'),
                pllimit='max',
            )

            for page in result.get('query', {}).get('pages', {}).values():
                media_titles = [link['title'] for link in page.get('links', [])]
                media_titles += [image['title'] for image in page.get('images', [])]
                if media_titles:
                    mediafiles |= self.get_mw_page_list(media_titles)
        return mediafiles

    def get_mw_mediafile_for_page_revision(self, filename, timestamp):
        """Download the media file version matching ``timestamp``, if any."""
        if timestamp is None:
            return {}

        # Search if a media file with the given timestamp exists on MediaWiki.
        # In that case download the file.
        result = self.wiki.query(
            prop='imageinfo',
            titles=f'File:{filename}',
            iistart=timestamp,
            iiend=timestamp,
            iiprop='timestamp|archivename|url',
            iilimit=1,
        )

        pages = result.get('query', {}).get('pages', {})
        if not pages:
            return {}
        page = next(iter(pages.values()))
        # If there is no imageinfo it means there is no revision of the file
        # for the given timestamp.
        imageinfo = page.get('imageinfo')
        if not imageinfo:
            return {}

        fileinfo = imageinfo[-1]
        warn(f'\tDownloading file {filename}, version {fileinfo["timestamp"]}')
        content = self.download_mw_mediafile(fileinfo['url'])
        if content is None:
            warn(f'\tFAILED downloading {fileinfo["url"]}! Skipping!')
            return {}
        return {
            'content': content,
            'title': filename,
            'timestamp': fileinfo['timestamp'],
        }

    def download_mw_mediafile(self, download_url):
        response = self.wiki.session.get(download_url)
        if response.status_code == HTTP_CODE_OK:
            return response.content
        if not download_url.startswith(self.url) and f'{self.wiki_name}/' in download_url:
            # We may have failed because the URL returned from the API is
            # missing something (e.g. "user:password@"). Retry with a
            # corresponding URL constructed from our original url.
            download_url = re.sub(
                rf'^.*?{re.escape(self.wiki_name)}/', f'{self.url}/', download_url, count=1
            )
            return self.download_mw_mediafile(download_url)
        warn('Error downloading mediafile from :')
        warn(f'URL: {download_url}')
        warn(f'Server response: {response.status_code} {response.reason}')
        return None

    ################################## revisions ##############################

    def get_last_local_revision(self):
        # Get note regarding last mediawiki revision.
        note = run_git(
            [
                'notes',
                f'--ref={self.remotename}/mediawiki',
                'show',
                f'refs/mediawiki/{self.remotename}/master',
            ],
            quiet=True,
        )
        note_info = note.split(' ')

        if len(note_info) < 2 or note_info[0] != 'mediawiki_revision:':
            warn('No previous mediawiki revision found', end='')
            return 0

        # Notes are formatted : mediawiki_revision: #number
        lastrevision_number = int(note_info[1].strip())
        warn(
            f'Last local mediawiki revision found is {lastrevision_number}',
            end='',
        )
        return lastrevision_number

    def get_last_global_remote_rev(self):
        """Return the id of the last revision of the wiki, tracked or not.

        This makes a single request to the wiki, thus avoiding a loop over all
        tracked pages. This is useful for the fetch-by-rev option.
        """
        result = self.wiki.query(
            list='recentchanges', prop='revisions', rclimit='1', rcdir='older'
        )
        return result['query']['recentchanges'][0]['revid']

    def get_last_remote_revision(self):
        """Return the last revision id of the tracked pages and categories."""

        pages = list(self.get_mw_pages().values())
        max_rev_num = 0

        warn('Getting last revision id on tracked pages...')

        for page in pages:
            page_id = page['pageid']
            result = self.wiki.query(
                prop='revisions', rvprop='ids|timestamp', pageids=page_id
            )
            revisions = result['query']['pages'][str(page_id)].get('revisions')
            if not revisions:
                continue
            lastrev = revisions[-1]
            self.basetimestamps[lastrev['revid']] = lastrev['timestamp']
            max_rev_num = max(max_rev_num, lastrev['revid'])

        warn(f'Last remote revision found is {max_rev_num}.')
        return max_rev_num

    ############################### content filters ###########################

    @staticmethod
    def mediawiki_clean(string, page_created):
        """Clean content before sending it to MediaWiki."""
        # Mediawiki does not allow blank space at the end of a page and ends
        # with a single \n. This function right trims a string and adds a \n at
        # the end to follow this rule.
        string = string.rstrip(' \t\n\r\f\v')
        if not string and page_created:
            # Creating empty pages is forbidden.
            string = EMPTY_CONTENT
        return f'{string}\n'

    @staticmethod
    def mediawiki_smudge(string):
        """Filter applied on MediaWiki data before adding them to Git."""
        if string == EMPTY_CONTENT:
            string = ''
        # This \n is important. This is due to mediawiki's way to handle end of
        # files.
        return f'{string}\n'

    ############################# remote-helper commands ######################

    def mw_capabilities(self):
        # Revisions are imported to the private namespace
        # refs/mediawiki/$remotename/ by the helper and fetched into
        # refs/remotes/$remotename later by fetch.
        emit(f'refspec refs/heads/*:refs/mediawiki/{self.remotename}/*\n')
        emit('import\n')
        emit('list\n')
        emit('push\n')
        if self.dumb_push:
            emit('no-private-update\n')
        emit('\n')

    def mw_list(self, for_push=None):
        # MediaWiki does not have branches, we consider one branch arbitrarily
        # called master, and HEAD pointing to it.
        emit('? refs/heads/master\n')
        emit('@refs/heads/master HEAD\n')
        emit('\n')

    def mw_option(self, name, value):
        warn(f"remote-helper command 'option {name}' not yet implemented")
        emit('unsupported\n')

    ################################### import ################################

    def fetch_mw_revisions_for_page(self, page, page_id, fetch_from):
        page_revs = []
        query = {
            'prop': 'revisions',
            'rvprop': 'ids',
            'rvdir': 'newer',
            'rvlimit': 500,
            'pageids': page_id,
            # Let MediaWiki know that we support the latest API.
            'continue': '',
        }
        # Don't add the start if it is 1 since not all pages start at 1
        if fetch_from != 1:
            query['rvstartid'] = fetch_from

        # Get 500 revisions at a time due to the mediawiki api limit
        while True:
            result = self.wiki.query(**query)

            revisions = (
                result.get('query', {})
                .get('pages', {})
                .get(str(page_id), {})
                .get('revisions', [])
            )
            for revision in revisions:
                page_revs.append(
                    {'pageid': page['pageid'], 'revid': revision['revid']}
                )

            if 'query-continue' in result:  # For legacy APIs
                query['rvstartid'] = result['query-continue']['revisions']['rvstartid']
            elif 'continue' in result:  # For newer APIs
                query['rvcontinue'] = result['continue']['rvcontinue']
                query['continue'] = result['continue']['continue']
            else:
                break

        if self.shallow_import and page_revs:
            warn('  Found 1 revision (shallow import).')
            return [max(page_revs, key=lambda rev: rev['revid'])]
        warn(f'  Found {len(page_revs)} revision(s).')
        return page_revs

    def fetch_mw_revisions(self, pages, fetch_from):
        revisions = []
        for n, page in enumerate(pages, start=1):
            warn(f'page {n}/{len(pages)}: {page["title"]}')
            revisions = (
                self.fetch_mw_revisions_for_page(page, page['pageid'], fetch_from)
                + revisions
            )
        return revisions

    def import_file_revision(self, commit, full_import, n, mediafile=None):
        title = commit['title']
        comment = commit['comment']
        content = commit['content']
        author = commit['author']
        date = commit['date']
        epoch = int(date.timestamp())

        emit(f'commit refs/mediawiki/{self.remotename}/master\n')
        emit(f'mark :{n}\n')
        emit(f'committer {author} <{author}@{self.wiki_name}> {epoch} +0000\n')
        literal_data(comment)

        # If it's not a clone, we need to know where to start from
        if not full_import and n == 1:
            emit(f'from refs/mediawiki/{self.remotename}/master^0\n')
        if content != DELETED_CONTENT:
            emit(f'M 644 inline {fe_escape_path(f"{title}.mw")}\n')
            literal_data(content)
            if mediafile:
                emit(f'M 644 inline {fe_escape_path(mediafile["title"])}\n')
                literal_data(mediafile['content'])
            emit('\n\n')
        else:
            emit(f'D {fe_escape_path(f"{title}.mw")}\n')

        # mediawiki revision number in the git note
        if full_import and n == 1:
            emit(f'reset refs/notes/{self.remotename}/mediawiki\n')
        emit(f'commit refs/notes/{self.remotename}/mediawiki\n')
        emit(f'committer {author} <{author}@{self.wiki_name}> {epoch} +0000\n')
        literal_data('Note added by git-mediawiki during import')
        if not full_import and n == 1:
            emit(f'from refs/notes/{self.remotename}/mediawiki^0\n')
        emit(f'N inline :{n}\n')
        literal_data(f'mediawiki_revision: {commit["mw_revision"]}')
        emit('\n\n')

    @staticmethod
    def get_more_refs(cmd):
        """Read a batch of ``<cmd> <arg>`` lines, terminated by a blank line."""
        refs = []
        while True:
            line = sys.stdin.readline()
            if line in ('\n', ''):
                return refs
            match = re.match(rf'^{cmd} (.*)$', line.rstrip('\n'))
            if not match:
                raise SystemExit(f"Invalid command in a '{cmd}' batch: {line.rstrip()}")
            refs.append(match.group(1))

    def mw_import(self, ref):
        # multiple import commands can follow each other.
        refs = [ref, *self.get_more_refs('import')]
        processed_refs = set()
        for one_ref in refs:
            # skip duplicates: "import refs/heads/master" being issued twice;
            # TODO: why?
            if one_ref in processed_refs:
                continue
            processed_refs.add(one_ref)
            self.mw_import_ref(one_ref)
        emit('done\n')

    def mw_import_ref(self, ref):
        # The remote helper will call "import HEAD" and
        # "import refs/heads/master".
        # Since HEAD is a symbolic ref to master (by convention, followed by
        # the output of the command "list" that we gave), we don't need to do
        # anything in this case.
        if ref == 'HEAD':
            return

        self.connect()

        warn('Searching revisions...')
        last_local = self.get_last_local_revision()
        fetch_from = last_local + 1
        if fetch_from == 1:
            warn(', fetching from beginning.')
        else:
            warn(', fetching from here.')

        if self.fetch_strategy == 'by_rev':
            warn('Fetching & writing export data by revs...')
            n = self.mw_import_ref_by_revs(fetch_from)
        elif self.fetch_strategy == 'by_page':
            warn('Fetching & writing export data by pages...')
            n = self.mw_import_ref_by_pages(fetch_from)
        else:
            warn(f'fatal: invalid fetch strategy "{self.fetch_strategy}".')
            warn(
                'Check your configuration variables '
                f'remote.{self.remotename}.fetchStrategy and mediawiki.fetchStrategy',
            )
            raise SystemExit(1)

        if fetch_from == 1 and n == 0:
            warn('You appear to have cloned an empty MediaWiki.')
            # Something has to be done remote-helper side. If nothing is done,
            # an error is thrown saying that HEAD is referring to unknown
            # object 0000000000000000000 and the clone fails.

    def mw_import_ref_by_pages(self, fetch_from):
        pages = self.get_mw_pages()
        revisions = self.fetch_mw_revisions(list(pages.values()), fetch_from)
        revisions.sort(key=lambda revision: revision['revid'])
        revision_ids = [revision['revid'] for revision in revisions]
        return self.mw_import_revids(fetch_from, revision_ids, pages)

    def mw_import_ref_by_revs(self, fetch_from):
        pages = self.get_mw_pages()
        last_remote = self.get_last_global_remote_rev()
        revision_ids = list(range(fetch_from, last_remote + 1))
        return self.mw_import_revids(fetch_from, revision_ids, pages)

    def mw_import_revids(self, fetch_from, revision_ids, pages):
        """Import the given revisions, restricted to the given pages.

        ``revision_ids`` is a list of revision numbers, ``pages`` a mapping
        keyed by page title: only revisions of those pages are imported.
        """
        n = 0
        n_actual = 0
        total = len(revision_ids)

        for page_rev_ids in itertools.batched(revision_ids, MAX_REVS, strict=False):
            # Count page even if we skip it, since we display n/total and
            # total includes skipped pages.
            n += len(page_rev_ids)

            # fetch the content of the pages
            revs = '|'.join(str(revid) for revid in page_rev_ids)
            try:
                result = self.wiki.query(
                    prop='revisions',
                    rvprop='content|timestamp|comment|user|ids',
                    revids=revs,
                )
            except WIKI_ERRORS as error:
                raise SystemExit(
                    f'Failed to retrieve modified page for revision(s) {revs}'
                ) from error

            for result_page in result.get('query', {}).get('pages', {}).values():
                n_actual = self.handle_result_page(
                    n, total, fetch_from, result_page, pages, n_actual
                )

        return n_actual

    def handle_result_page(self, n, total, fetch_from, result_page, pages, n_actual):
        page_title = result_page['title']
        # Placeholder in case a revision has no timestamp.
        last_timestamp = datetime.fromtimestamp(0, UTC)

        for rev in result_page.get('revisions', []):
            if page_title not in pages:
                warn(f'{n}/{total}: Skipping revision #{rev["revid"]} of {page_title}')
                continue

            n_actual += 1

            content = revision_content(rev)
            if content is None:
                # This may not be the best thing to do with suppressed
                # revisions -- it creates a huge difference between three
                # revisions (e.g. 100000 chars -> ~30 chars -> 100000 chars).
                content = SUPPRESSED_REVISION
            else:
                content = self.mediawiki_smudge(content)

            timestamp = rev.get('timestamp')
            if timestamp is None:
                last_timestamp += timedelta(seconds=1)
            else:
                last_timestamp = datetime.fromisoformat(timestamp)

            commit = {
                'author': rev.get('user') or 'Anonymous',
                'comment': rev.get('comment') or EMPTY_MESSAGE,
                'title': smudge_filename(page_title),
                'mw_revision': rev['revid'],
                'content': content,
                'date': last_timestamp,
            }

            # Differentiates classic pages and media files.
            namespace, separator, filename = page_title.partition(':')
            mediafile = {}
            if separator and namespace:
                namespace_id = self.get_mw_namespace_id(namespace)
                if namespace_id and namespace_id == self.get_mw_namespace_id('File'):
                    mediafile = self.get_mw_mediafile_for_page_revision(
                        filename, timestamp
                    )
            # If this is a revision of the media page for a new version of a
            # file, do one common commit for both file and media page.
            # Else do a commit only for that page.
            warn(f'{n}/{total}: Revision #{rev["revid"]} of {commit["title"]}')
            self.import_file_revision(commit, fetch_from == 1, n_actual, mediafile)

        return n_actual

    #################################### push #################################

    @staticmethod
    def error_non_fast_forward(remote):
        if git_config_bool('advice.pushNonFastForward', default=True):
            # Native git-push would show this after the summary. We can't ask
            # it to display it cleanly, so print it ourselves before.
            warn('To prevent you from losing history, non-fast-forward updates were rejected')
            warn("Merge the remote changes (e.g. 'git pull') before pushing again. See the")
            warn("'Note about fast-forwards' section of 'git push --help' for details.")
        emit(f'error {remote} "non-fast-forward"\n')
        return False

    def mw_upload_file(self, complete_file_name, new_sha1, extension, file_deleted, summary):
        newrevid = None
        path = f'File:{complete_file_name}'
        if extension not in self.get_allowed_file_extensions():
            warn(f'{complete_file_name} is not a permitted file on this wiki.')
            warn('Check the configuration of file uploads in your mediawiki.')
            return newrevid

        # Deleting and uploading a file requires a privileged user
        if file_deleted:
            try:
                self.wiki.delete(title=path, reason=summary)
            except WIKI_ERRORS as error:
                warn('Failed to delete file on remote wiki')
                warn('Check your permissions on the remote site. Error code:')
                warn(str(error))
                raise SystemExit(1) from error
            return newrevid

        content = run_git_bytes(['cat-file', 'blob', new_sha1])
        if not content:
            warn(f'Empty file {complete_file_name} not pushed.')
            return newrevid

        try:
            self.wiki.upload(complete_file_name, content, summary)
        except WIKI_ERRORS as error:
            raise SystemExit(
                f'Failed to upload {complete_file_name} '
                f'({type(error).__name__}: {error})'
            ) from error
        last_file_page = self.wiki.get_page(path)
        newrevid = (last_file_page or {}).get('revid')
        warn(f'Pushed file: {new_sha1} - {complete_file_name}.')
        return newrevid

    def mw_push_file(self, diff_info, complete_file_name, summary, oldrevid):
        """Push one blob and return the resulting MediaWiki revision id.

        ``diff_info`` contains a string in this format:
        100644 100644 <sha1_of_blob_before_commit> <sha1_of_blob_now> <status>

        Raises :class:`NonFastForward` if the wiki rejected the edit.
        """
        diff_info_split = diff_info.split()
        newrevid = None

        if summary == EMPTY_MESSAGE:
            summary = ''

        new_sha1 = diff_info_split[3]
        old_sha1 = diff_info_split[2]
        page_created = is_null_sha1(old_sha1)
        page_deleted = is_null_sha1(new_sha1)
        complete_file_name = clean_filename(complete_file_name)

        match = re.match(r'^(.*)\.([^.]*)$', complete_file_name)
        title = match.group(1) if match else None
        extension = match.group(2) if match else ''

        if extension == 'mw':
            namespace_id = self.get_mw_namespace_id_for_page(complete_file_name)
            if (
                namespace_id
                and namespace_id == self.get_mw_namespace_id('File')
                and not self.export_media
            ):
                warn(f'Ignoring media file related page: {complete_file_name}')
                return oldrevid
            if page_deleted:
                # Deleting a page usually requires special privileges. A common
                # convention is to replace the page with this content instead:
                file_content = DELETED_CONTENT
            else:
                file_content = run_git(['cat-file', 'blob', new_sha1])

            params = {
                'summary': summary,
                'title': title,
                'text': self.mediawiki_clean(file_content, page_created),
            }
            basetimestamp = self.basetimestamps.get(oldrevid)
            if basetimestamp:
                params['basetimestamp'] = basetimestamp

            try:
                result = self.wiki.edit(**params)
            except APIError as error:
                # edit conflicts, considered as non-fast-forward
                warn(f'Warning: Error {error} from mediawiki.')
                raise NonFastForward from error
            except WIKI_ERRORS as error:
                # Other errors. Shouldn't happen => just give up.
                raise SystemExit(f'Fatal: Error {error} from mediawiki') from error

            newrevid = result.get('edit', {}).get('newrevid')
            warn(f'Pushed file: {new_sha1} - {title}')
        elif self.export_media:
            newrevid = self.mw_upload_file(
                complete_file_name, new_sha1, extension, page_deleted, summary
            )
        else:
            warn(f'Ignoring media file {complete_file_name}')

        return newrevid or oldrevid

    def mw_push(self, refspec):
        # multiple push statements can follow each other
        refspecs = [refspec, *self.get_more_refs('push')]
        pushed = False
        for one_refspec in refspecs:
            match = re.match(r'^(\+)?([^:]*):([^:]*)$', one_refspec)
            if not match:
                raise SystemExit(
                    'Invalid refspec for push. Expected <src>:<dst> or +<src>:<dst>'
                )
            force, local, remote = match.groups()
            if force:
                warn('Warning: forced push not allowed on a MediaWiki.')
            if not local:
                warn('Cannot delete remote branch on a MediaWiki')
                emit(f'error {remote} cannot delete\n')
                continue
            if remote != 'refs/heads/master':
                warn("Only push to the branch 'master' is supported on a MediaWiki")
                emit(f'error {remote} only master allowed\n')
                continue
            if self.mw_push_revision(local, remote):
                pushed = True

        # Notify Git that the push is done
        emit('\n')

        if pushed and self.dumb_push:
            warn('Just pushed some revisions to MediaWiki.')
            warn('The pushed revisions now have to be re-imported, and your current branch')
            warn('needs to be updated with these re-imported commits. You can do this with')
            warn()
            warn('  git pull --rebase')
            warn()

    def mw_push_revision(self, local, remote):
        # ``remote`` actually has to be "refs/heads/master" at this point.
        last_local_revid = self.get_last_local_revision()
        warn('.')  # Finish the sentence started above
        last_remote_revid = self.get_last_remote_revision()
        mw_revision = last_remote_revid

        # Get sha1 of commit pointed by local HEAD
        head_sha1 = run_git(['rev-parse', local], quiet=True).strip()
        # Get sha1 of commit pointed by remotes/$remotename/master
        remoteorigin_sha1 = run_git(
            ['rev-parse', f'refs/remotes/{self.remotename}/master'], quiet=True
        ).strip()

        if 0 < last_local_revid < last_remote_revid:
            return self.error_non_fast_forward(remote)

        if head_sha1 == remoteorigin_sha1:
            # nothing to push
            return False

        # Get every commit in between HEAD and refs/remotes/origin/master,
        # including HEAD and refs/remotes/origin/master
        commit_pairs = []
        if last_local_revid > 0:
            parsed_sha1 = remoteorigin_sha1
            # Find a path from last MediaWiki commit to pushed commit
            warn('Computing path from local to remote ...')
            local_ancestry = {}
            for line in run_git(
                ['rev-list', '--boundary', '--parents', local, f'^{parsed_sha1}']
            ).splitlines():
                match = re.match(r'^-?([a-f0-9]+) ([a-f0-9 ]+)', line)
                if match:
                    child, parents = match.groups()
                    for parent in parents.split(' '):
                        local_ancestry[parent] = child
                elif not re.match(r'^-?[a-f0-9]+$', line):
                    raise SystemExit(f'Unexpected output from git rev-list: {line}')
            while parsed_sha1 != head_sha1:
                child = local_ancestry.get(parsed_sha1)
                if not child:
                    warn('Cannot find a path in history from remote commit to last commit')
                    return self.error_non_fast_forward(remote)
                commit_pairs.append([parsed_sha1, child])
                parsed_sha1 = child
        else:
            # No remote mediawiki revision. Export the whole history
            # (linearized with --first-parent)
            warn('Warning: no common ancestor, pushing complete history')
            history = run_git(['rev-list', '--first-parent', '--children', local]).splitlines()
            for line in reversed(history[1:]):
                commit_pairs.append(line.split())

        for commit_info_split in commit_pairs:
            sha1_child = commit_info_split[0]
            sha1_commit = commit_info_split[1]
            # TODO: we could detect renames, and encode them with a #redirect
            # on the wiki. TODO: for now, it's just a delete+add
            diff_infos = run_git(
                ['diff-tree', '-r', '--raw', '-z', sha1_child, sha1_commit]
            )
            # git diff-tree -z gives an output like
            # <metadata>\0<filename1>\0
            # <metadata>\0<filename2>\0
            # and we split on \0.
            diff_info_list = [part for part in diff_infos.split('\0') if part]
            # Keep the subject line of the commit message as mediawiki comment
            # for the revision
            commit_msg = run_git(['log', '--no-walk', '--format=%s', sha1_commit]).rstrip('\n')
            # Push every blob
            try:
                for info, name in itertools.batched(diff_info_list, 2, strict=True):
                    mw_revision = self.mw_push_file(info, name, commit_msg, mw_revision)
            except NonFastForward:
                # we may already have sent part of the commit to MediaWiki, but
                # it's too late to cancel it. Stop the push in the middle, but
                # still give an accurate error message.
                return self.error_non_fast_forward(remote)
            if not self.dumb_push:
                run_git(
                    [
                        'notes',
                        f'--ref={self.remotename}/mediawiki',
                        'add',
                        '-f',
                        '-m',
                        f'mediawiki_revision: {mw_revision}',
                        sha1_commit,
                    ]
                )

        emit(f'ok {remote}\n')
        return True

    ################################## namespaces #############################

    def get_allowed_file_extensions(self):
        result = self.wiki.query(meta='siteinfo', siprop='fileextensions')
        return {
            entry['ext'] for entry in result['query']['fileextensions']
        }

    def get_mw_namespace_id(self, name):
        """Return the MediaWiki id for a canonical namespace name.

        Ex.: "File", "Project". Returns None when there is no such namespace.
        """
        if name not in self.namespace_id:
            warn(f'Namespace {name} not found in cache, querying the wiki ...')
            # NS not found => get namespace ids from MW and store the requested
            # one in the configuration file.
            result = self.wiki.query(meta='siteinfo', siprop='namespaces')
            for namespace in result['query']['namespaces'].values():
                if namespace.get('id') is None or namespace.get('canonical') is None:
                    continue
                self.namespace_id[namespace['canonical']] = namespace['id']
                if namespace.get('*'):
                    # alias (e.g. french Fichier: as alias for canonical File:)
                    self.namespace_id[namespace['*']] = namespace['id']

        if name not in self.namespace_id:
            known = ' '.join(
                namespace.replace(' ', '_') for namespace in sorted(self.namespace_id)
            )
            warn(f'No such namespace {name} on MediaWiki, known namespaces: {known}')
            self.namespace_id[name] = None

        namespace_id = self.namespace_id[name]

        # Store "notANameSpace" as special value for inexisting namespaces
        store_id = 'notANameSpace' if namespace_id is None else str(namespace_id)

        # Store explicitly requested namespaces on disk
        if name not in self.cached_mw_namespace_id:
            run_git(
                [
                    'config',
                    '--add',
                    f'remote.{self.remotename}.namespaceCache',
                    f'{name}:{store_id}',
                ]
            )
            self.cached_mw_namespace_id.add(name)
        return namespace_id

    def get_mw_namespace_id_for_page(self, page):
        namespace, separator, _ = page.partition(':')
        if not separator:
            return None
        return self.get_mw_namespace_id(namespace)


def exit_error_usage():
    raise SystemExit(
        'ERROR: git-remote-mediawiki module was not called with a correct number of\n'
        'parameters\n'
        'You may obtain this error because you attempted to run the git-remote-mediawiki\n'
        'module directly.\n'
        'This module can be used the following way:\n'
        '\tgit clone mediawiki://<address of a mediawiki>\n'
        'Then, use git commit, push and pull as with every normal git repository.'
    )


def main(argv):
    if len(argv) != 2:
        exit_error_usage()

    # By default, use UTF-8 to communicate with Git and the user
    sys.stdin.reconfigure(encoding='utf-8')
    sys.stderr.reconfigure(encoding='utf-8')

    helper = GitRemoteMediaWiki(argv[0], argv[1])

    # Commands parser
    while True:
        line = sys.stdin.readline()
        if not line:
            break
        if not helper.parse_command(line.rstrip('\n')):
            break
        # flush stdout, to make sure the previous command is fully processed.
        sys.stdout.buffer.flush()


if __name__ == '__main__':
    main(sys.argv[1:])
